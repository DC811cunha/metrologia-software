# =============================================================
# SoftMeter — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# NUNCA comite o arquivo .env no repositório
# =============================================================

# Ambiente — com ENVIRONMENT=production a API se recusa a iniciar se JWT_SECRET/JWT_REFRESH_SECRET
# forem os valores de exemplo, tiverem menos de 32 caracteres ou forem iguais entre si, se
# COOKIE_SECURE não for true ou se o banco usar a senha padrão. Gere segredos com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Para produção use o docker-compose.prod.yml (ver README).
ENVIRONMENT=development

# Banco de dados
DB_USER=softmeter
DB_PASSWORD=softmeter123
DB_NAME=softmeter_db
DATABASE_URL=postgresql://softmeter:softmeter123@localhost:5432/softmeter_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# GitHub — opcional, mas necessário para a métrica de Cobertura de Testes ler o
# artifact de CI mais recente do repositório analisado (a API de artifacts do
# GitHub Actions exige autenticação mesmo em repositórios públicos). Sem token,
# essa fonte é ignorada silenciosamente e o sistema cai para os artefatos
# versionados no código-fonte (coverage.xml/lcov.info/badge no README).
# Baixar (não só listar) artifacts exige escopo — gere em
# https://github.com/settings/tokens:
#   - Classic: marque o escopo "repo" (mesmo para repositórios públicos, o
#     escopo restrito "public_repo" NÃO é suficiente para baixar artifacts).
#   - Fine-grained: habilite a permissão "Actions: Read-only" explicitamente.
GITHUB_TOKEN=

# Resend — opcional, usado para enviar o e-mail de recuperação de senha
# ("esqueci minha senha"). Sem chave configurada, o link de redefinição é
# apenas registrado no log do backend em vez de enviado por e-mail; o fluxo
# nunca quebra por falta dessa configuração. Sem domínio próprio verificado no
# Resend, a conta opera em modo sandbox e só entrega e-mails à caixa de
# entrada dona da própria conta Resend — ver ADR-005 para detalhes e o que
# muda quando o projeto tiver um domínio.
RESEND_API_KEY=
EMAIL_FROM=SoftMeter <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60

# JWT
JWT_SECRET=TROQUE_PARA_UM_VALOR_SECRETO_EM_PRODUCAO
JWT_REFRESH_SECRET=TROQUE_PARA_OUTRO_VALOR_SECRETO_EM_PRODUCAO
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Cookie do refresh token: ligue (true) sempre que a API for servida por HTTPS, para que o
# navegador nunca o envie por HTTP puro. Em desenvolvimento local (http://localhost) mantenha false.
COOKIE_SECURE=false

# Backend
PORT=3001

# Frontend
VITE_API_URL=http://localhost:3001
