# =============================================================
# SoftMeter — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# NUNCA comite o arquivo .env no repositório
# =============================================================

# Banco de dados
DB_USER=softmeter
DB_PASSWORD=softmeter123
DB_NAME=softmeter_db
DATABASE_URL=postgresql://softmeter:softmeter123@localhost:5432/softmeter_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# GitHub — opcional, mas necessário para a métrica de Cobertura de Testes ler o
# artifact de CI mais recente do repositório analisado (a API de artifacts do
# GitHub Actions exige autenticação mesmo em repositórios públicos). Sem token,
# essa fonte é ignorada silenciosamente e o sistema cai para os artefatos
# versionados no código-fonte (coverage.xml/lcov.info/badge no README).
# Baixar (não só listar) artifacts exige escopo — gere em
# https://github.com/settings/tokens:
#   - Classic: marque o escopo "repo" (mesmo para repositórios públicos, o
#     escopo restrito "public_repo" NÃO é suficiente para baixar artifacts).
#   - Fine-grained: habilite a permissão "Actions: Read-only" explicitamente.
GITHUB_TOKEN=

# JWT
JWT_SECRET=TROQUE_PARA_UM_VALOR_SECRETO_EM_PRODUCAO
JWT_REFRESH_SECRET=TROQUE_PARA_OUTRO_VALOR_SECRETO_EM_PRODUCAO
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Backend
PORT=3001

# Frontend
VITE_API_URL=http://localhost:3001
