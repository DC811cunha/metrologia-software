# =============================================================
# SoftMeter — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# NUNCA comite o arquivo .env no repositório
# =============================================================

# Banco de dados
DB_USER=softmeter
DB_PASSWORD=softmeter123
DB_NAME=softmeter_db
DATABASE_URL=postgresql://softmeter:softmeter123@localhost:5432/softmeter_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=TROQUE_PARA_UM_VALOR_SECRETO_EM_PRODUCAO
JWT_REFRESH_SECRET=TROQUE_PARA_OUTRO_VALOR_SECRETO_EM_PRODUCAO
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# Backend
PORT=3001

# Frontend
VITE_API_URL=http://localhost:3001
